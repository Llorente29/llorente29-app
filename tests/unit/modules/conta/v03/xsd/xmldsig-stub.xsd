<?xml version="1.0" encoding="UTF-8"?>
<!-- V03 · Sustituto local de xmldsig-core-schema.xsd (W3C) para validar SIN RED.
     Los XSD de la AEAT lo importan para una firma opcional que VERI*FACTU no usa;
     aquí solo hace falta que el elemento exista. Los XSD de la AEAT no se tocan. -->
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.w3.org/2000/09/xmldsig#" elementFormDefault="qualified">
  <element name="Signature" type="anyType"/>
</schema>
