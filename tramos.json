  "dichos": [
    {
      "id": "llega",
      "texto": "Tu proveedor te manda la factura por correo, como siempre.",
      "dura": 3.44,
      "desde": 5.028
    },
    {
      "id": "lee",
      "texto": "Sumied abre el PDF y lo lee entero: el proveedor, el número, la fecha, cada línea y cada tipo de IVA.",
      "dura": 8.72,
      "desde": 9.375
    },
    {
      "id": "igual",
      "texto": "Y comprueba que lo que ha leído cuadra con el PDF, al céntimo.",
      "dura": 4.72,
      "desde": 18.998
    },
    {
      "id": "apunta",
      "texto": "Si todo cuadra, la apunta sola en tu contabilidad, con su asiento ya validado.",
      "dura": 5.2,
      "desde": 24.732
    },
    {
      "id": "porque",
      "texto": "Y te enseña por qué: cada requisito de la factura, comprobado. Si algo no encaja, te avisa y te dice qué falta.",
      "dura": 8.32,
      "desde": 30.834
    },
    {
      "id": "pagos",
      "texto": "En Pagos ves lo que toca pagar hoy: lo vencido y lo que vence esta semana.",
      "dura": 5.28,
      "desde": 43.427
    },
    {
      "id": "semana",
      "texto": "Un solo botón: pagar lo de esta semana. Sumied marca las facturas que tocan.",
      "dura": 6,
      "desde": 49.607
    },
    {
      "id": "titular",
      "texto": "Antes de pagar, Revolut comprueba que el titular de cada IBAN es de verdad tu proveedor.",
      "dura": 6.08,
      "desde": 56.92
    },
    {
      "id": "segunda",
      "texto": "Si un proveedor estrena IBAN, Sumied pide una segunda confirmación. Es el engaño más común con facturas falsas.",
      "dura": 8.32,
      "desde": 63.902
    },
    {
      "id": "desde",
      "texto": "Salen de tu cuenta de Revolut, conectada a Sumied, y ves el saldo antes y después.",
      "dura": 6,
      "desde": 73.127
    },
    {
      "id": "una",
      "texto": "Una sola aprobación vale para todos los pagos.",
      "dura": 3.36,
      "desde": 80.249
    },
    {
      "id": "pin",
      "texto": "Confirmas con tu PIN de pago, y listo.",
      "dura": 2.8,
      "desde": 87.165
    },
    {
      "id": "enviado",
      "texto": "Hecho: los tres pagos salen por Revolut, sin entrar en el banco.",
      "dura": 4.88,
      "desde": 93.769
    },
    {
      "id": "justificante",
      "texto": "Cada pago sale con su justificante, listo para mandárselo al proveedor.",
      "dura": 4.56,
      "desde": 99.55
    },
    {
      "id": "pagado",
      "texto": "Y Pagos ya los cuenta como pagados este mes.",
      "dura": 3.2,
      "desde": 105.012
    },
    {
      "id": "vuelve",
      "texto": "Cuando el cargo llega al banco, Sumied lo reconoce solo.",
      "dura": 3.92,
      "desde": 111.488
    },
    {
      "id": "casado",
      "texto": "Cada cargo queda casado con su factura, y su asiento, hecho. Sin conciliar a mano.",
      "dura": 6.16,
      "desde": 117.245
    },
    {
      "id": "resumen",
      "texto": "Tres facturas, del correo al banco, sin teclear un solo dato.",
      "dura": 4.64,
      "desde": 124.307
    }
  ],
