{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/E/:token",
      "has": [{ "type": "host", "value": "(?<marca>.*)" }],
      "destination": "https://xzmpnchlguibclvxyynt.supabase.co/functions/v1/label-scan?t=:token&h=:marca"
    },
    {
      "source": "/e/:token",
      "has": [{ "type": "host", "value": "(?<marca>.*)" }],
      "destination": "https://xzmpnchlguibclvxyynt.supabase.co/functions/v1/label-scan?t=:token&h=:marca"
    },
    {
      "source": "/E/:token",
      "destination": "https://xzmpnchlguibclvxyynt.supabase.co/functions/v1/label-scan?t=:token"
    },
    {
      "source": "/e/:token",
      "destination": "https://xzmpnchlguibclvxyynt.supabase.co/functions/v1/label-scan?t=:token"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "marca", "value": "contabilidad" }],
      "missing": [
        { "type": "host", "value": "(.*\\.)?folvy\\.app" },
        { "type": "host", "value": "folvy-app\\.vercel\\.app" }
      ],
      "destination": "/marcas/contabilidad/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
